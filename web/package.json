{
  "name": "groundwork-web",
  "version": "0.1.0",
  "private": true,
  "description": "The Groundwork web app: one page app the API serves, locally and hosted.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc --noEmit",
    "types": "openapi-typescript openapi.json -o lib/api-types.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "baseui": "18.2.0",
    "echarts": "6.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.4",
    "styletron-engine-monolithic": "1.0.0",
    "styletron-react": "6.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "type": "module",
  "overrides": {
    "@types/react": "$@types/react"
  }
}
