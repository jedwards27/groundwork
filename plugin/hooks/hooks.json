{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/server/start.sh\" prepare",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*(send|reply|forward|post|invite|respond|create_event|update_event).*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/outbound-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
