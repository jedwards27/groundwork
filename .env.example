# ---------------------------------------------------------------------------
# Groundwork configuration. Copy to .env (`cp .env.example .env`) and fill in.
# Every variable the code reads is listed here. Never commit .env.
# ---------------------------------------------------------------------------

# Claude API key. The only external account Groundwork needs.
# Without it, the planner falls back to the hand-written simulated planner (with a banner).
ANTHROPIC_API_KEY=

# Models (pinned per deployment; recorded on every ledger entry).
GROUNDWORK_PLANNER_MODEL=claude-opus-5-5
GROUNDWORK_CLASSIFIER_MODEL=claude-haiku-5-5
GROUNDWORK_REPORT_MODEL=claude-haiku-5-5

# Postgres. Two roles: the owner runs migrations and fixture loads (bypasses row-level
# security); the app role is what the API uses and is bound by row-level security.
# Defaults match `make db-setup` (local) and docker-compose.yml. Dev-only passwords.
DATABASE_URL=postgresql+psycopg://groundwork_app:groundwork_app_dev@localhost:5432/groundwork
DATABASE_OWNER_URL=postgresql+psycopg://groundwork_owner:groundwork_owner_dev@localhost:5432/groundwork
TEST_DATABASE_URL=postgresql+psycopg://groundwork_app:groundwork_app_dev@localhost:5432/groundwork_test
TEST_DATABASE_OWNER_URL=postgresql+psycopg://groundwork_owner:groundwork_owner_dev@localhost:5432/groundwork_test

# Dev identity. Anyone holding this secret can mint a token for any seeded person:
# it is the trust root in development. `make setup` generates a random one into .env.
GROUNDWORK_DEV_HMAC_SECRET=
# Token lifetime in hours (24 in dev; the hosted profile uses 1).
GROUNDWORK_TOKEN_TTL_HOURS=24

# Safety defaults. Executors never send anything while this is true.
EXECUTORS_DRY_RUN=true

# Hosted-demo switches. In the hosted profile dry run is forced on regardless of the above.
GROUNDWORK_HOSTED=false
# Live planning calls allowed per day across all visitors before falling back to simulated.
GROUNDWORK_DAILY_LIVE_RUN_CAP=50
# Demo personas: the web app's server may log in as any seeded person (no password). Local and the
# hosted demo only; never enable for real data.
GROUNDWORK_DEMO_LOGIN=true
GROUNDWORK_DEMO_ORG=Groundwork demo org (end-user posture)
# Token required by POST /admin/reset.
GROUNDWORK_ADMIN_TOKEN=

# Web app: Next.js collects anonymous telemetry unless this is set. Groundwork keeps it off.
NEXT_TELEMETRY_DISABLED=1
# Where the web app's server routes reach the API.
GROUNDWORK_API_URL=http://localhost:8000

# docker compose: host port for Postgres (`docker compose up -d db`), if 5432 is taken.
# GROUNDWORK_DB_PORT=5432

# Browser tests (`make e2e`). By default they use your installed Google Chrome and start the API
# and web app if they are not running. PW_CHANNEL= (empty) uses Playwright's own Chromium instead
# (after `npx playwright install chromium`); E2E_BASE_URL tests an already-running stack.
# PW_CHANNEL=chrome
# E2E_BASE_URL=http://localhost:3000
